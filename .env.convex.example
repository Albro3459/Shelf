# Copy to .env.convex and import into each target Convex deployment
# Set SITE_URL to the frontend address used for sign-in
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
SITE_URL=http://localhost:5173
# npm run auth:setup generates JWT_PRIVATE_KEY and JWKS on the selected backend
# Keep those generated keys on the backend, outside this file

AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=your-ses-region
SES_FROM_EMAIL="Shelf <noreply@shelf.example.com>"
