{
  "name": "ebrpl-catalog-client",
  "homepage": "https://shelf.gocloudlaunch.com",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "auth:setup": "auth",
    "convex": "convex",
    "catalog": "tsx src/cli.ts",
    "dev": "convex dev --typecheck enable --start \"npm run dev:web\"",
    "dev:web": "vite",
    "build": "npm run typecheck && tsc -p tsconfig.json && vite build",
    "build:pages": "VITE_CONVEX_URL=https://good-snake-3.convex.cloud npm run build",
    "predeploy": "npm version patch --no-git-tag-version && npm run build:pages",
    "deploy": "gh-pages -d dist/web --branch gh-pages --nojekyll",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.core.json && tsc -p tsconfig.web.json && tsc -p tsconfig.tools.json && tsc -p convex/tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@aws-sdk/client-sesv2": "^3.1154.0",
    "@convex-dev/auth": "^0.0.96",
    "@rgrove/parse-xml": "^5.0.0",
    "convex": "^1.47.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
